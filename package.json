{
  "name": "barber-booking-backend",
  "version": "1.0.0",
  "description": "Backend API for barber shop appointment booking system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/kill-port.js 3000 && ts-node-dev --respawn --transpile-only src-back/All_Utils/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "install:all": "npm install && cd src-front && npm install --legacy-peer-deps",
    "dev:frontend": "cd src-front && npm run dev",
    "dev:backend": "npm run dev",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\"",
    "test:otp": "ts-node scripts/test-otp.ts"
  },
  "keywords": [
    "barber",
    "booking",
    "appointment",
    "api"
  ],
  "author": "Soheil saffari",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@types/node": "^20.10.5",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^7.1.3",
    "multer": "^1.4.5-lts.1",
    "redis": "^4.7.1",
    "soap": "^1.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "concurrently": "^9.1.2",
    "prisma": "^6.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
