meta {
  name: Create Profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/barber/profile
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  name: My Barbershop
  fullName: Barber Name
  gender: male
  address: 123 Main St
  profileImage: @file()
  backgroundImage: @file()
}
