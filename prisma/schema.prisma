generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Customer {
  id                Int               @id @default(autoincrement())
  fullName          String?           @map("full_name")
  email             String?           @unique
  phone             String            @unique
  password_hash     String?
  password_salt     String?
  avatar            String?
  gender            Gender?
  role              Role              @default(customer)
  email_verified_at BigInt?
  phone_verified    Boolean           @default(false)
  otp               String?
  otp_expires       BigInt?
  wallet_balance    Decimal           @default(0.00) @db.Decimal(20, 2)
  transaction_code  String?
  publicMeta        Json?             @map("public_meta")
  privateMeta       Json?             @map("private_meta")
  last_login        BigInt?
  created           BigInt            @default(0)
  updated           BigInt            @default(0)
  appointments      Appointment[]     @relation("CustomerAppointments")
  barber            Barber?           @relation("CustomerBarber")
  commentRates      CommentRate[]
  couponsUsed       CouponUsage[]
  packagePurchases  PackagePurchase[]
  transactions      Transaction[]     @relation("CustomerTransactions")
  sessions          UserSession[]     @relation("CustomerSessions")

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model Admin {
  id          Int           @id @default(autoincrement())
  fullName    String        @map("full_name")
  phone       String        @unique
  email       String?       @unique
  password    String
  avatar      String?
  role        Role          @default(staff_admin)
  isActive    Boolean       @default(true) @map("is_active")
  permissions Json?
  lastLoginAt DateTime?     @map("last_login_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  sessions    UserSession[] @relation("AdminSessions")

  @@index([phone])
  @@index([email])
  @@map("admin")
}

model Barber {
  id                 Int                 @id @default(autoincrement())
  userRefId          Int                 @unique @map("user_ref_id")
  fullName           String?             @map("full_name")
  specialization     String?
  experienceYears    Int?                @map("experience_years")
  bio                String?             @db.Text
  avatar             String?             @map("avatar")
  serviceAudience    Json?               @map("service_audience")
  gender             Gender?             @map("gender")
  email              String?             @unique
  phone              String?             @unique
  passwordHash       String?             @map("password_hash")
  emailVerifiedAt    BigInt?             @map("email_verified_at")
  phoneVerified      Boolean             @default(false) @map("phone_verified")
  walletBalance      Decimal             @default(0.00) @map("wallet_balance") @db.Decimal(20, 2)
  transactionCode    String?             @map("transaction_code")
  created            BigInt              @default(0) @map("created")
  updated            BigInt              @default(0) @map("updated")
  appointmentBarbers AppointmentBarber[]
  appointments       Appointment[]       @relation("BarberAppointments")
  kpis               BarberKPI[]
  schedules          BarberSchedule[]
  timeOff            BarberTimeOff[]
  customer           Customer            @relation("CustomerBarber", fields: [userRefId], references: [id], onDelete: Cascade)
  ownedBarbershops   Barbershop[]        @relation("BarbershopOwner")
  packagePurchases   PackagePurchase[]
  transactions       Transaction[]       @relation("BarberTransactions")
  sessions           UserSession[]       @relation("BarberSessions")

  @@index([userRefId])
  @@index([email])
  @@index([phone])
  @@map("barbers")
}

model Barbershop {
  id              Int                  @id @default(autoincrement())
  ownerId         Int                  @map("owner_id")
  name            String
  description     String?              @db.Text
  gender          BarbershopGender
  type            BarbershopType
  active          Boolean              @default(true)
  address         String?              @map("address")
  latitude        Decimal?             @db.Decimal(10, 7)
  longitude       Decimal?             @db.Decimal(10, 7)
  city            String?              @map("city")
  neighborhood    String?              @map("neighborhood")
  openingTime     String?              @map("opening_time")
  closingTime     String?              @map("closing_time")
  avatar          String?              @map("avatar")
  walletBalance   Decimal              @default(0.00) @map("wallet_balance") @db.Decimal(20, 2)
  transactionCode String?              @map("transaction_code")
  averageRating   Float                @default(0)
  ratingCount     Int                  @default(0)
  publicMeta      Json?                @map("public_meta")
  created         BigInt               @default(0) @map("created")
  updated         BigInt               @default(0) @map("updated")
  appointments    Appointment[]
  schedules       BarbershopSchedule[]
  owner           Barber               @relation("BarbershopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  commentRates    CommentRate[]
  services        Service[]
  transactions    Transaction[]

  @@index([ownerId])
  @@map("barbershops")
}

model Service {
  id              Int            @id @default(autoincrement())
  barbershopId    Int            @map("barbershop_id")
  parentServiceId Int?           @map("parent_service_id")
  name            String
  gender          ServiceGender
  estimatedTime   Int            @map("estimated_time")
  isVip           Boolean        @default(false) @map("is_vip")
  price           Decimal?       @db.Decimal(20, 2)
  description     String?        @db.Text
  readmore        String?        @db.Text
  files           Json?          @map("files")
  avatar          String?        @map("avatar")
  isMedical       Boolean        @default(false) @map("is_medical")
  created         BigInt         @default(0) @map("created")
  updated         BigInt         @default(0) @map("updated")
  appointments    Appointment[]  @relation("ServiceAppointments")
  commentRates    CommentRate[]
  addons          ServiceAddon[]
  barbershop      Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  parent          Service?       @relation("ServiceHierarchy", fields: [parentServiceId], references: [id])
  children        Service[]      @relation("ServiceHierarchy")

  @@index([barbershopId])
  @@index([parentServiceId], map: "services_parent_service_id_fkey")
  @@map("services")
}

model ServiceAddon {
  id                Int                @id @default(autoincrement())
  serviceId         Int                @map("service_id")
  name              String
  price             Decimal            @db.Decimal(20, 2)
  duration          Int
  created           BigInt             @default(0)
  updated           BigInt             @default(0)
  appointmentAddons AppointmentAddon[]
  service           Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_addons")
}

model Appointment {
  id                               Int                     @id @default(autoincrement())
  customerId                       Int                     @map("customer_id")
  barberId                         Int?                    @map("barber_id")
  serviceId                        Int?                    @map("service_id")
  barbershopId                     Int?                    @map("barbershop_id")
  locationType                     AppointmentLocationType @map("location_type")
  startTime                        BigInt                  @map("start_time")
  endTime                          BigInt                  @map("end_time")
  status                           AppointmentStatus       @default(pending)
  serviceType                      String?                 @map("service_type")
  notes                            String?                 @db.Text
  publicMeta                       Json?                   @map("public_meta")
  privateMeta                      Json?                   @map("private_meta")
  basePrice                        Decimal?                @map("base_price") @db.Decimal(20, 2)
  addonsTotal                      Decimal?                @map("addons_total") @db.Decimal(20, 2)
  priceTotal                       Decimal?                @map("price_total") @db.Decimal(20, 2)
  paidAmount                       Decimal?                @map("paid_amount") @db.Decimal(20, 2)
  paymentLockExternalTransactionId Int?                    @map("payment_lock_external_transaction_id")
  created                          BigInt                  @default(0) @map("created")
  updated                          BigInt                  @default(0) @map("updated")
  addons                           AppointmentAddon[]
  barbers                          AppointmentBarber[]
  logs                             AppointmentLog[]
  meta                             AppointmentMeta[]       @relation("AppointmentMeta")
  payments                         AppointmentPayment[]
  reminders                        AppointmentReminder[]
  barber                           Barber?                 @relation("BarberAppointments", fields: [barberId], references: [id])
  barbershop                       Barbershop?             @relation(fields: [barbershopId], references: [id])
  customer                         Customer                @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Cascade)
  service                          Service?                @relation("ServiceAppointments", fields: [serviceId], references: [id])
  commentRates                     CommentRate[]           @relation("CommentRateAppointments")
  couponUsages                     CouponUsage[]           @relation("CouponUsageAppointments")
  externalTransactions             ExternalTransaction[]   @relation("AppointmentTransactions")
  invoices                         Invoice[]
  transactions                     Transaction[]           @relation("TransactionAppointments")

  @@index([customerId])
  @@index([barberId])
  @@index([serviceId])
  @@index([barbershopId])
  @@index([startTime])
  @@map("appointments")
}

model AppointmentBarber {
  appointmentId Int
  barberId      Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barber        Barber      @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@id([appointmentId, barberId])
  @@index([barberId], map: "appointment_barbers_barberId_fkey")
  @@map("appointment_barbers")
}

model AppointmentAddon {
  id            Int          @id @default(autoincrement())
  appointmentId Int          @map("appointment_id")
  addonId       Int          @map("addon_id")
  price         Decimal      @db.Decimal(20, 2)
  duration      Int
  created       BigInt       @default(0)
  addon         ServiceAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([addonId], map: "appointment_addons_addon_id_fkey")
  @@map("appointment_addons")
}

model Wallet {
  id                       Int                   @id @default(autoincrement())
  ownerType                String                @map("owner_type")
  ownerId                  Int                   @map("owner_id")
  currency                 String                @default("IRR")
  balance                  Decimal               @default(0.00) @db.Decimal(20, 2)
  created                  BigInt                @default(0)
  updated                  BigInt                @default(0)
  internalTransactionsFrom InternalTransaction[] @relation("WalletInternalTxsFrom")
  internalTransactionsTo   InternalTransaction[] @relation("WalletInternalTxsTo")

  @@index([ownerType, ownerId])
  @@map("wallets")
}

model ExternalTransaction {
  id                   Int                     @id @default(autoincrement())
  initiatorType        String                  @map("initiator_type")
  initiatorId          Int                     @map("initiator_id")
  kind                 ExternalTransactionKind @map("kind")
  relatedAppointmentId Int?                    @map("related_appointment_id")
  amount               Decimal                 @db.Decimal(20, 2)
  method               PaymentMethod?
  status               TransactionStatus       @default(pending)
  reference            String?                 @map("reference")
  metadata             Json?
  created              BigInt                  @default(0)
  updated              BigInt                  @default(0)
  appointmentPayments  AppointmentPayment[]    @relation("AppointmentPaymentExternalTx")
  appointment          Appointment?            @relation("AppointmentTransactions", fields: [relatedAppointmentId], references: [id])
  internalTransactions InternalTransaction[]
  packagePurchases     PackagePurchase[]

  @@index([initiatorType, initiatorId])
  @@index([relatedAppointmentId])
  @@map("external_transactions")
}

model InternalTransaction {
  id                          Int                  @id @default(autoincrement())
  parentExternalTransactionId Int                  @map("parent_external_transaction_id")
  fromWalletId                Int?                 @map("from_wallet_id")
  toWalletId                  Int?                 @map("to_wallet_id")
  amount                      Decimal              @db.Decimal(20, 2)
  direction                   TransactionDirection
  note                        String?              @db.Text
  created                     BigInt               @default(0)
  fromWallet                  Wallet?              @relation("WalletInternalTxsFrom", fields: [fromWalletId], references: [id])
  parentExternal              ExternalTransaction  @relation(fields: [parentExternalTransactionId], references: [id], onDelete: Cascade)
  toWallet                    Wallet?              @relation("WalletInternalTxsTo", fields: [toWalletId], references: [id])

  @@index([parentExternalTransactionId])
  @@index([fromWalletId])
  @@index([toWalletId])
  @@map("internal_transactions")
}

model AppointmentPayment {
  id                    Int                  @id @default(autoincrement())
  appointmentId         Int                  @map("appointment_id")
  externalTransactionId Int?                 @map("external_transaction_id")
  amount                Decimal              @db.Decimal(20, 2)
  method                PaymentMethod?
  paidAt                BigInt?              @map("paid_at")
  created               BigInt               @default(0)
  appointment           Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  externalTx            ExternalTransaction? @relation("AppointmentPaymentExternalTx", fields: [externalTransactionId], references: [id])

  @@index([appointmentId])
  @@index([externalTransactionId], map: "appointment_payments_external_transaction_id_fkey")
  @@map("appointment_payments")
}

model Invoice {
  id            Int            @id @default(autoincrement())
  appointmentId Int            @map("appointment_id")
  invoiceNo     String         @unique @map("invoice_no")
  total         Decimal        @db.Decimal(20, 2)
  discount      Decimal?       @db.Decimal(20, 2)
  tax           Decimal?       @db.Decimal(20, 2)
  grandTotal    Decimal        @map("grand_total") @db.Decimal(20, 2)
  method        PaymentMethod?
  created       BigInt         @default(0)
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("invoices")
}

model Coupon {
  id         Int           @id @default(autoincrement())
  code       String        @unique
  kind       String
  value      Decimal?      @db.Decimal(20, 2)
  usageMax   Int?          @map("usage_max")
  usageCount Int           @default(0) @map("usage_count")
  expiresAt  BigInt?       @map("expires_at")
  created    BigInt        @default(0)
  updated    BigInt        @default(0)
  usages     CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id            Int          @id @default(autoincrement())
  couponId      Int          @map("coupon_id")
  customerId    Int?         @map("customer_id")
  appointmentId Int?         @map("appointment_id")
  usedAt        BigInt       @map("used_at")
  appointment   Appointment? @relation("CouponUsageAppointments", fields: [appointmentId], references: [id])
  coupon        Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer      Customer?    @relation(fields: [customerId], references: [id])

  @@index([couponId])
  @@index([customerId])
  @@index([appointmentId], map: "coupon_usages_appointment_id_fkey")
  @@map("coupon_usages")
}

model BarberSchedule {
  id       Int    @id @default(autoincrement())
  barberId Int    @map("barber_id")
  weekday  Int
  startMs  Int    @map("start_ms")
  endMs    Int    @map("end_ms")
  created  BigInt @default(0)
  updated  BigInt @default(0)
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("barber_schedules")
}

model BarberTimeOff {
  id       Int     @id @default(autoincrement())
  barberId Int     @map("barber_id")
  startAt  BigInt  @map("start_at")
  endAt    BigInt  @map("end_at")
  reason   String?
  created  BigInt  @default(0)
  updated  BigInt  @default(0)
  barber   Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("barber_time_off")
}

model BarbershopSchedule {
  id         Int        @id @default(autoincrement())
  shopId     Int        @map("shop_id")
  weekday    Int
  openMs     Int        @map("open_ms")
  closeMs    Int        @map("close_ms")
  isClosed   Boolean    @default(false)
  created    BigInt     @default(0)
  updated    BigInt     @default(0)
  barbershop Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("barbershop_schedules")
}

model Notification {
  id          Int                @id @default(autoincrement())
  userType    String             @map("user_type")
  userId      Int?               @map("user_id")
  channel     String
  payload     Json?
  status      NotificationStatus @default(pending)
  errorMsg    String?            @map("error_msg")
  attempts    Int                @default(0)
  scheduledAt BigInt?            @map("scheduled_at")
  sentAt      BigInt?            @map("sent_at")
  created     BigInt             @default(0)

  @@index([userType, userId])
  @@map("notifications")
}

model AppointmentReminder {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @map("appointment_id")
  channel       String
  sendAt        BigInt      @map("send_at")
  sent          Boolean     @default(false)
  created       BigInt      @default(0)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_reminders")
}

model AppointmentLog {
  id            Int               @id @default(autoincrement())
  appointmentId Int               @map("appointment_id")
  status        AppointmentStatus
  note          String?           @db.Text
  changedByType String?           @map("changed_by_type")
  changedById   Int?              @map("changed_by_id")
  changedAt     BigInt            @map("changed_at")
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_logs")
}

model UserSession {
  id           Int       @id @default(autoincrement())
  customerId   Int?      @map("customer_id")
  barberId     Int?      @map("barber_id")
  token        String?   @unique
  refreshToken String?   @unique @map("refresh_token")
  device       String?
  ip           String?
  expiresAt    BigInt?   @map("expires_at")
  created      BigInt    @default(0)
  adminId      Int?      @map("admin_id")
  admin        Admin?    @relation("AdminSessions", fields: [adminId], references: [id], onDelete: Cascade)
  barber       Barber?   @relation("BarberSessions", fields: [barberId], references: [id], onDelete: Cascade)
  customer     Customer? @relation("CustomerSessions", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([barberId])
  @@index([adminId])
  @@index([refreshToken])
  @@map("user_sessions")
}

model AppointmentMeta {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @map("appointment_id")
  metaKey       String      @map("meta_key")
  metaValue     String?     @map("meta_value")
  created       BigInt      @default(0)
  appointment   Appointment @relation("AppointmentMeta", fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_meta")
}

model BarberKPI {
  id           Int     @id @default(autoincrement())
  barberId     Int     @map("barber_id")
  date         BigInt
  revenue      Decimal @db.Decimal(20, 2)
  appointments Int
  ratingAvg    Float
  created      BigInt  @default(0)
  barber       Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, date])
  @@map("barber_kpis")
}

model CommentRate {
  id              Int           @id @default(autoincrement())
  customerId      Int?          @map("customer_id")
  barbershopId    Int?          @map("barbershop_id")
  serviceId       Int?          @map("service_id")
  appointmentId   Int?          @map("appointment_id")
  parentCommentId Int?          @map("parent_comment_id")
  comment         String?       @db.Text
  rate            Int?
  commentMeta     Json?         @map("comment_meta")
  created         BigInt        @default(0)
  updated         BigInt        @default(0)
  appointment     Appointment?  @relation("CommentRateAppointments", fields: [appointmentId], references: [id])
  barbershop      Barbershop?   @relation(fields: [barbershopId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  parent          CommentRate?  @relation("CommentHierarchy", fields: [parentCommentId], references: [id])
  replies         CommentRate[] @relation("CommentHierarchy")
  service         Service?      @relation(fields: [serviceId], references: [id])

  @@index([customerId])
  @@index([barbershopId])
  @@index([serviceId])
  @@index([appointmentId])
  @@index([parentCommentId])
  @@map("comment_rates")
}

model Transaction {
  id           Int                  @id @default(autoincrement())
  type         TransactionType
  direction    TransactionDirection
  authority    String?
  status       TransactionStatus    @default(pending)
  referenceId  Int?                 @map("reference_id")
  parentId     Int?                 @map("parent_id")
  customerId   Int?                 @map("customer_id")
  barberId     Int?                 @map("barber_id")
  barbershopId Int?                 @map("barbershop_id")
  amount       Decimal              @db.Decimal(20, 2)
  description  String?              @db.Text
  created      BigInt               @default(0)
  updated      BigInt               @default(0)
  barber       Barber?              @relation("BarberTransactions", fields: [barberId], references: [id])
  barbershop   Barbershop?          @relation(fields: [barbershopId], references: [id])
  customer     Customer?            @relation("CustomerTransactions", fields: [customerId], references: [id])
  parent       Transaction?         @relation("TransactionHierarchy", fields: [parentId], references: [id])
  children     Transaction[]        @relation("TransactionHierarchy")
  appointment  Appointment?         @relation("TransactionAppointments", fields: [referenceId], references: [id])

  @@index([customerId])
  @@index([barberId])
  @@index([barbershopId])
  @@index([referenceId])
  @@index([parentId])
  @@index([type])
  @@index([status])
  @@map("transactions")
}

model Package {
  id            Int               @id @default(autoincrement())
  name          String
  description   String?           @db.Text
  type          PackageType
  price         Decimal           @db.Decimal(20, 2)
  depositAmount Decimal?          @map("deposit_amount") @db.Decimal(20, 2)
  serviceIds    Json?             @map("service_ids")
  active        Boolean           @default(true)
  validFrom     BigInt?           @map("valid_from")
  validUntil    BigInt?           @map("valid_until")
  created       BigInt            @default(0)
  updated       BigInt            @default(0)
  purchases     PackagePurchase[]

  @@map("packages")
}

model PackagePurchase {
  id                    Int                  @id @default(autoincrement())
  packageId             Int                  @map("package_id")
  customerId            Int?                 @map("customer_id")
  barberId              Int?                 @map("barber_id")
  externalTransactionId Int?                 @map("external_transaction_id")
  amount                Decimal              @db.Decimal(20, 2)
  used                  Boolean              @default(false)
  expiresAt             BigInt?              @map("expires_at")
  created               BigInt               @default(0)
  barber                Barber?              @relation(fields: [barberId], references: [id])
  customer              Customer?            @relation(fields: [customerId], references: [id])
  externalTransaction   ExternalTransaction? @relation(fields: [externalTransactionId], references: [id])
  package               Package              @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([customerId])
  @@index([barberId])
  @@index([externalTransactionId])
  @@map("package_purchases")
}

enum Role {
  customer
  admin
  staff_admin
}

enum BarbershopGender {
  male
  female
  unisex
}

enum BarbershopType {
  fixed
  onsite
  hybrid
}

enum ServiceGender {
  male
  female
  other
}

enum AppointmentStatus {
  pending
  confirmed
  paid
  completed
  cancelled
  no_show
}

enum AppointmentLocationType {
  customer_location
  barbershop_fixed
}

enum TransactionType {
  external
  internal
}

enum ExternalTransactionKind {
  deposit
  withdrawal
  appointment_lock
  payout
}

enum TransactionDirection {
  credit
  debit
}

enum TransactionStatus {
  pending
  success
  failed
}

enum PaymentMethod {
  cash
  card
  online
  wallet
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum Gender {
  male
  female
  other
}

enum PackageType {
  deposit
  full_payment
  subscription
}
