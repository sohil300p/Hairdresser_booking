// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Customer {
  id           Int       @id @default(autoincrement())
  fullName     String?   @map("full_name")
  phone        String    @unique
  password     String?   @map("password")
  avatar       String?   @map("avatar")
  otp          String?
  otpExpiresAt DateTime? @map("otp_expires_at") @db.Timestamp(3)
  publicMeta   Json?     @map("public_meta")
  privateMeta  Json?     @map("private_meta")
  role         Role      @default(customer)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamp(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  appointments Appointment[]
  files        File[]
  commentRates CommentRate[]

  @@map("customer")
}

model Barber {
  id              Int      @id @default(autoincrement())
  specialization  String?
  experienceYears Int?     @map("experience_years")
  bio             String?  @db.Text
  avatar          String?  @map("avatar")
  serviceAudience Json?    @map("service_audience")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  appointments     Appointment[] @relation("BarberAppointments")
  ownedBarbershops Barbershop[]  @relation("BarbershopOwner")

  @@map("barbers")
}

model Barbershop {
  id                Int              @id @default(autoincrement())
  name              String
  description       String?          @db.Text
  gender            BarbershopGender
  type              BarbershopType
  active            Boolean          @default(true)
  deactivatedReason String?          @map("deactivated_reason") @db.Text
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  city              String?          @map("city")
  neighborhood      String?          @map("neighborhood")
  ownerId           Int              @map("owner_id")
  openingTime       String?          @map("opening_time")
  closingTime       String?          @map("closing_time")
  averageRating     Float            @default(0)
  ratingCount       Int              @default(0)
  minServicePrice   Decimal?         @map("min_service_price") @db.Decimal(10, 2)
  maxServicePrice   Decimal?         @map("max_service_price") @db.Decimal(10, 2)
  startingPrice     Decimal?         @map("starting_price") @db.Decimal(10, 2)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamp(3)

  owner        Barber        @relation("BarbershopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  services     Service[]
  commentRates CommentRate[]

  @@map("barbershops")
}

model Service {
  id              Int           @id @default(autoincrement())
  barbershopId    Int           @map("barbershop_id")
  parentServiceId Int?          @map("parent_service_id")
  name            String
  gender          ServiceGender
  estimatedTime   Int           @map("estimated_time")
  isVip           Boolean       @default(false) @map("is_vip")
  price           Decimal       @db.Decimal(10, 2)
  description     String?       @db.Text
  reamemore       String?       @db.Text
  files           Json?         @map("files")
  isMedical       Boolean       @default(false) @map("is_medical")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  parent       Service?      @relation("ServiceHierarchy", fields: [parentServiceId], references: [id])
  children     Service[]     @relation("ServiceHierarchy")
  appointments Appointment[] @relation("ServiceAppointments")

  @@map("services")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  customerId      Int               @map("customer_id")
  barberId        Int?              @map("barber_id")
  serviceId       Int?              @map("service_id")
  appointmentDate DateTime          @map("appointment_date") @db.Timestamp(3)
  status          AppointmentStatus @default(pending)
  serviceType     String?           @map("service_type")
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber   Barber?  @relation("BarberAppointments", fields: [barberId], references: [id], onDelete: SetNull)
  service  Service? @relation("ServiceAppointments", fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

model File {
  id         Int      @id @default(autoincrement())
  fileUrl    String   @map("file_url") @db.Text
  fileName   String   @map("file_name")
  bucket     String
  type       FileType
  customerId Int      @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("files")
}

model CommentRate {
  id              Int      @id @default(autoincrement())
  barbershopId    Int      @map("barbershop_id")
  customerId      Int      @map("customer_id")
  commentId       String   @default(uuid()) @map("comment_id")
  comment         String?  @db.Text
  commentRate     Int      @map("comment_rate")
  commentMeta     Json?    @map("comment_meta")
  parentCommentId Int?     @map("parent_comment_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  barbershop Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  parent     CommentRate?  @relation("CommentThread", fields: [parentCommentId], references: [id])
  replies    CommentRate[] @relation("CommentThread")

  @@map("comment_rates")
}

enum Role {
  customer
  barber
  admin
}

enum FileType {
  profile
  portfolio
  other
}

enum BarbershopGender {
  male
  female
  unisex
}

enum BarbershopType {
  fixed
  mobile
  hybrid
}

enum ServiceGender {
  male
  female
  other
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
}
