// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           Int       @id @default(autoincrement())
  fullName     String?   @map("full_name")
  phone        String    @unique
  password     String?   @map("password")
  avatar       String?   @map("avatar")
  otp          String?
  otpExpiresAt DateTime? @map("otp_expires_at")
  publicMeta   Json?     @map("public_meta")
  privateMeta  Json?     @map("private_meta")
  role         Role      @default(customer)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("customer")
}

model Barber {
  id              Int      @id @default(autoincrement())
  specialization  String?
  experienceYears Int?     @map("experience_years")
  bio             String?  @db.Text
  avatar    String?  @map("avatar")
  serviceAudience Json?    @map("service_audience")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ownedBarbershops Barbershop[]  @relation("BarbershopOwner")

  @@map("barbers")
}

model Barbershop {
  id                Int              @id @default(autoincrement())
  name              String
  description       String?          @db.Text
  gender            BarbershopGender
  type              BarbershopType
  active            Boolean          @default(true)
  deactivatedReason String?          @map("deactivated_reason") @db.Text
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  city              String?          @map("city")
  neighborhood      String?          @map("neighborhood")
  ownerId           Int              @map("owner_id")
  openingTime       String?          @map("opening_time")
  closingTime       String?          @map("closing_time")
  averageRating     Float            @default(0)
  ratingCount       Int              @default(0)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  owner    Barber             @relation("BarbershopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  services Service[]

  @@map("barbershops")
}

model Service {
  id            Int           @id @default(autoincrement())
  barbershopId  Int           @map("barbershop_id")
  name          String
  gender        ServiceGender
  estimatedTime Int           @map("estimated_time")
  isVip         Boolean       @default(false) @map("is_vip")
  description   String?       @db.Text
  readmore     String?       @db.Text
  isMedical     Boolean       @default(false) @map("is_medical")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("services")
}


model Appointment {
  id              Int               @id @default(autoincrement())
  customerId      Int               @map("customer_id")
  barberId        Int?              @map("barber_id")
  serviceId       Int?              @map("service_id")
  appointmentDate DateTime          @map("appointment_date")
  status          AppointmentStatus @default(pending)
  serviceType     String?           @map("service_type")
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber   Barber?  @relation("BarberAppointments", fields: [barberId], references: [id], onDelete: SetNull)
  staff    Staff?   @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: SetNull)
  service  Service? @relation("ServiceAppointments", fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

model File {
  id         Int      @id @default(autoincrement())
  fileUrl    String   @map("file_url") @db.Text
  fileName   String   @map("file_name")
  bucket     String
  type       FileType
  customerId Int      @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("files")
}

model BarbershopRating {
  id           Int      @id @default(autoincrement())
  barbershopId Int      @map("barbershop_id")
  customerId   Int      @map("customer_id")
  score        Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("barbershop_ratings")
}

enum Role {
  /// مشتری سیستم
  customer
  /// آرایشگر فعال در سیستم
  barber
  /// مدیر سیستم
  admin
}

enum FileType {
  profile
  portfolio
  other
}

enum BarbershopGender {
  male
  female
  unisex
}

enum BarbershopType {
  fixed
  mobile
  hybrid
}

enum ServiceGender {
  male
  female
  other
}

enum StaffGender {
  male
  female
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
}
