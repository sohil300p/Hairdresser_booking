# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Update these values according to your MySQL setup
# Format: mysql://username:password@host:port/database_name
# For Docker Compose: mysql://barberuser:barberpass@localhost:3307/barber_booking
# Note: Port 3307 is used if 3306 is already in use
DATABASE_URL="mysql://username:password@localhost:3306/database_name"
# Shadow database URL for Prisma migrations (uses root to create shadow databases)
# Required for Prisma migrations - must use root user with CREATE DATABASE privileges
SHADOW_DATABASE_URL="mysql://root:rootpassword@localhost:3306/database_name"

# JWT Configuration
# IMPORTANT: Change these secrets in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-minimum-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
# Update according to your Redis setup
REDIS_URL=redis://localhost:6379

# MinIO Object Storage Configuration
# For local development with Docker Compose
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=barber-uploads
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
# MinIO Console URL for admin access
MINIO_CONSOLE_URL=http://localhost:9001
# Public URL for serving uploaded files
MINIO_PUBLIC_URL=http://localhost:9000

# For Production MinIO Setup:
# MINIO_ENDPOINT=your-minio-server.com
# MINIO_PORT=443
# MINIO_ACCESS_KEY=your-production-access-key
# MINIO_SECRET_KEY=your-production-secret-key
# MINIO_USE_SSL=true
# MINIO_PUBLIC_URL=https://your-minio-server.com

# API Documentation
SWAGGER_BASE_PATH=/api-docs

# MeliPayamak SMS Gateway Configuration
# Get your credentials from https://melipayamak.com/
# Alternative variable names (for backward compatibility):
# MELLI_USERNAME, MELLI_PASSWORD, MELLI_SENDER, MELLI_AUTH_PATTERN_ID
MELIPAYAMAK_USERNAME=your-melipayamak-username
MELIPAYAMAK_PASSWORD=your-melipayamak-password
MELIPAYAMAK_FROM=your-sender-number

# Pattern IDs for SMS templates (obtain from MeliPayamak dashboard)
# Create patterns in your MeliPayamak account and note the pattern IDs
MELIPAYAMAK_AUTH_PATTERN_ID=your-auth-pattern-id
MELIPAYAMAK_RESERVE_PATTERN_ID=your-reserve-pattern-id
MELIPAYAMAK_CANCEL_RESERVE_PATTERN_ID=your-cancel-pattern-id

# Frontend Configuration
# Base URL for API calls from frontend applications (used at build time in Docker).
# Local dev: leave unset; Vite dev servers on 3001–3004 proxy /api to backend.
# Production Docker (same compose): http://backend:3000/api
# Production (external backend): https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:3000/api

# Frontend URL (used for payment gateway callbacks)
FRONTEND_URL=http://localhost:8080

# Service Ports – backend 3000; frontends 3001–3004 (docker-compose.production.yml maps these)
PORT=3000
VITE_USER_PORT=3001
VITE_BARBER_PORT=3002
VITE_ADMIN_PORT=3003
VITE_FASTPATH_PORT=3004

# Map.ir (نقشه ایران) - Barbershop address/map selection in barber panel
# MAPIR_API_KEY: backend proxy (/api/mapir/reverse, /api/mapir/search) – server-side only
# VITE_MAPIR_API_KEY: barber frontend map tiles (build-time in Docker)
# MAPIR_BASE_URL / MAPIR_SEARCH_BASE_URL / MAPIR_PLACES_BASE_URL: optional overrides
MAPIR_API_KEY=your-mapir-api-key
VITE_MAPIR_API_KEY=your-mapir-api-key

# Payment Gateway Configuration (ZarrinPal)
# Get your merchant ID from https://zarinpal.com/
ZARRINPAL_MERCHANT_ID=your-zarrinpal-merchant-id
# Use sandbox mode in development (true) or production mode (false)
ZARRINPAL_SANDBOX=true
# Payment callback URL (optional, defaults to FRONTEND_URL/api/payment/verify)
ZARRINPAL_CALLBACK_URL=http://localhost:8080/api/payment/verify

# AI Configuration (Optional)
GEMINI_API_KEY=your-gemini-api-key

# Testing Configuration
PHONE_NUMBER_TEST=09123456789

# Firebase Notification Configuration (backend)
# Paste your Firebase Service Account JSON content here as a single line string
# Example: FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "..."}'
FIREBASE_SERVICE_ACCOUNT=''

# Firebase – build-time for user & fastpath frontends (Docker build args)
# VITE_FIREBASE_* are embedded at build time; set in .env when building images
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Production / Docker (shared infrastructure) ---
# docker-compose.production.yml does NOT run MySQL, Redis, or MinIO.
# Set these to your shared infra hosts (e.g. from another compose or managed services).
# NODE_ENV=production
# DATABASE_URL="mysql://prod_user:secure_password@prod_mysql_host:3306/prod_database"
# SHADOW_DATABASE_URL="mysql://root:rootpassword@prod_mysql_host:3306/prod_database"
# REDIS_URL=redis://prod_redis_host:6379
# MINIO_ENDPOINT=prod-minio.yourdomain.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_PUBLIC_URL=https://prod-minio.yourdomain.com
# JWT_SECRET=your-very-secure-production-jwt-secret-at-least-32-characters-long
# JWT_REFRESH_SECRET=your-very-secure-production-refresh-secret-at-least-32-characters-long
